{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "prometheus": { "model": "zai-coding-plan/glm-5.3" },
    "explore": { "model": "opencode-go/deepseek-v4-flash" },
    "librarian": { "model": "opencode-go/deepseek-v4-flash" },
    "metis": { "model": "openai/gpt-5.6-terra" },
    "momus": { "model": "openai/gpt-6-astra#high" },
    "oracle": { "model": "openai/gpt-5.6-terra#xhigh" },
    "multimodal-looker": { "model": "openrouter/google/gemini-3.5-flash" },
    "builder": { "model": "openai/gpt-6-luna#max" }
  }
}
